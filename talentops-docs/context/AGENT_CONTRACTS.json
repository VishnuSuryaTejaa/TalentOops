{
  "version": "1.2.0",
  "locked": true,
  "change_policy": "Any change requires a dated DECISIONS.md entry. v1.1.0 changes authorized by D12/D13/D14/D16; v1.1.1 (meeting_ref: recall.ai -> webrtc) authorized by D17; v1.2.0 (gemini_session_config added; hybrid_loop_compliance added; scorecard input clarified as text-only) authorized by D18/D19.",
  "envelope": {
    "msg_id": "uuid",
    "ts": "ISO-8601",
    "from": "manager | sourcing_screening | scheduling | interviewer | scorecard | communication",
    "to": "manager | sourcing_screening | scheduling | interviewer | scorecard | communication",
    "type": "task.assign | task.result | task.error | event.completion | escalation",
    "role_id": "uuid",
    "candidate_id": "uuid | null",
    "voice_context": "user | candidate | null",
    "payload": "object"
  },
  "voice_ownership_rule": {
    "user": ["manager"],
    "candidate": ["interviewer"],
    "enforcement": "Reject any message whose voice_context is not permitted for its speaking agent. Manager never speaks to a candidate; Interviewer never speaks to the user."
  },
  "task_assign": {
    "sourcing_screening": {
      "jd_ref": "uuid",
      "enriched_jd_embedding_ref": "uuid (JD + frozen hidden-context appendix, D14)",
      "hidden_context_ref": "uuid | null",
      "corpus_ref": "uuid",
      "similarity_floor": "number [TBD]",
      "batch_size": "int"
    },
    "scheduling": {
      "candidate_id": "uuid",
      "panel_calendar_refs": ["string"],
      "slot_window": { "start": "ISO-8601", "end": "ISO-8601" },
      "duration_min": "int"
    },
    "interviewer": {
      "rubric_ref": "uuid (frozen rubric)",
      "difficulty_level": "L1 | L2 | L3",
      "interview_brief_ref": "uuid (per-candidate interview brief)",
      "candidate_profile_ref": "uuid",
      "resume_ref": "uuid",
      "meeting_ref": "webrtc session id",
      "gemini_session_config": {
        "primary_model": "gemini-3.1-flash-live-preview",
        "fallback_model": "gemini-2.5-flash-native-audio",
        "audio_in": true,
        "audio_out": true,
        "transcript_out": true,
        "scoring_output": false,
        "note": "D19 Hybrid Loop: Gemini Live is conversational interface only. scoring_output MUST be false. Transcript is passed to text-only scorer."
      },
      "bias_guardrails": {
        "protected_attributes_blocklist": ["string"],
        "evidence_only": true,
        "prosody_scoring": false
      },
      "sandbox": {
        "enabled": "bool",
        "duration_sec": 120,
        "graded": false
      },
      "confidence_threshold": "number 0.0-1.0 [TBD]"
    },
    "scorecard": {
      "transcript_ref": "uuid (raw text transcript from Gemini Live auto-transcript stream — D19; text only, NO audio)",
      "rubric_ref": "uuid",
      "candidate_id": "uuid",
      "hybrid_loop_compliance": "This task_assign MUST contain only transcript_ref (text). Audio refs are prohibited. D19 Hybrid Loop: scorecard sub-agent has zero access to audio or paralinguistic signals."
    },
    "communication": {
      "decision": "invite | reject | offer",
      "template_ref": "uuid",
      "candidate_id": "uuid",
      "requires_user_approval": "bool (true for offer)"
    }
  },
  "task_result": {
    "sourcing_screening": {
      "batch_id": "uuid",
      "candidates": [
        {
          "candidate_id": "uuid",
          "similarity_score": "number",
          "profile_ref": "uuid",
          "screening_notes": "string"
        }
      ]
    },
    "scheduling": {
      "candidate_id": "uuid",
      "status": "confirmed | conflict | rejected",
      "slot": { "start": "ISO-8601", "end": "ISO-8601" },
      "calendar_event_ref": "string",
      "conflict_count": "int"
    },
    "interviewer": {
      "candidate_id": "uuid",
      "transcript_ref": "uuid (immutable)",
      "questions": [
        {
          "q_id": "uuid",
          "ts": "ISO-8601",
          "competency_id": "string",
          "question_text_ref": "uuid",
          "rating": "number",
          "difficulty_estimate": "number (feeds Fairness & Bias Lens, D15)",
          "confidence": "number 0.0-1.0",
          "flags": ["string"]
        }
      ],
      "anomaly_flags": ["string"],
      "rubric_coverage": [{ "competency_id": "string", "covered": "bool" }],
      "needs_human_review": "bool",
      "call_meta": {
        "started_ts": "ISO-8601",
        "ended_ts": "ISO-8601",
        "consent_acknowledged": "bool (must be true for a valid report)",
        "sandbox_telemetry_ref": "uuid | null (non-graded, excluded from evaluation, D12)"
      }
    },
    "scorecard": {
      "candidate_id": "uuid",
      "scorecard": {
        "competencies": [
          {
            "competency_id": "string",
            "demonstrated_level": "L1 | L2 | L3 | insufficient_evidence",
            "evidence_quotes": [
              {
                "quote": "verbatim string",
                "char_start": "int",
                "char_end": "int",
                "speaker": "candidate | interviewer",
                "validated": "bool (substring-matched against immutable transcript, D13)"
              }
            ]
          }
        ],
        "overall_fit": "number",
        "needs_human_review": "bool"
      }
    },
    "communication": {
      "candidate_id": "uuid",
      "email_type": "invite | reject | offer",
      "status": "sent | bounced | failed",
      "message_id": "string"
    }
  },
  "escalation": {
    "reason": "low_confidence | double_conflict | no_qualified_candidates | review_limit_exceeded | delivery_failure | protected_attribute_flag",
    "details_ref": "uuid",
    "candidate_id": "uuid | null"
  },
  "event_completion": {
    "task_ref": "uuid",
    "status": "done | partial | failed",
    "result_ref": "uuid | null"
  }
}
