# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"

# AI Services
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# Vexa Bot Configuration
VEXA_BASE_URL="http://localhost:18056"
VEXA_API_KEY="your-vexa-api-key"

# CORS Configuration - Security
# In development: use http://localhost:5173 (Vite default)
# In production: use your actual domain(s) separated by commas
# Examples:
#   http://localhost:5173
#   https://talentops.example.com
#   https://talentops.example.com,https://dashboard.example.com
CORS_ORIGINS="http://localhost:5173"

# Agent Configuration
CONFIDENCE_THRESHOLD=0.6
TELEMETRY_MAX_RTT_MS=400.0
TELEMETRY_MAX_JITTER_MS=100.0
K_ANONYMITY=5
SANDBOX_MAX_SEC=120

# Speech (STT / TTS)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY="your-deepgram-api-key"
TTS_PROVIDER=google

# Offline Mode (for testing without API calls)
OFFLINE_MODE=false